# ─────────────────────────────────────────────────────
# NurseLearn PH — Environment Configuration
# ─────────────────────────────────────────────────────
# Copy to .env and fill in production values.
# Generate JWT secrets:  openssl rand -base64 48
# ─────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/nurselearn_ph

# ── Server ───────────────────────────────────────────
PORT=3002
NODE_ENV=development                  # production | development | test

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_STRONG_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_STRONG_SECRET_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────
CLIENT_URL=http://localhost:5173      # production: https://your-domain.com

# ── Self-signup ──────────────────────────────────────
# approval: email verification first, admin activates the account (default)
# auto:     account activates as soon as the email is verified
# off:      no public signup page / registration endpoint rejects
SIGNUP_MODE=approval

# ── AI (optional — falls back to mock when unset) ────
AI_PROVIDER=none                     # gemini | none
GEMINI_API_KEY=                      # required if AI_PROVIDER=gemini

# ── Email (optional — priority: Resend > SMTP > dry-run) ─
# Resend: https://resend.com — verify a domain before going live.
RESEND_API_KEY=                       # re_... ; unset = fall through to SMTP/dry-run
RESEND_FROM=NurseLearn PH <noreply@your-domain.com>   # must be on a verified Resend domain
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM="NurseLearn PH <noreply@your-domain.com>"

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=info                       # production: info | warn | error
